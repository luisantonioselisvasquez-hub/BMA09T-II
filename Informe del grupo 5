// ============================================================================
// COLA DE PRIORIDAD C++ CON SOPORTE PARA CAMBIO DE PRIORIDAD (CHANGE-KEY)
// Compatible con Dev-C++ 5.11
// ============================================================================
#include <iostream>
#include <vector>
#include <string>
#include <stdexcept>
#include <algorithm>

using namespace std;

struct Elemento {
    string id;
    int prioridad;

    Elemento(string s, int p) : id(s), prioridad(p) {}
};

class ColaPrioridadCustom {
private:
    vector<Elemento> heap;

    int parent(int i) const { return (i - 1) / 2; }
    int left(int i) const { return 2 * i + 1; }
    int right(int i) const { return 2 * i + 2; }

    void siftUp(int i) {
        while (i > 0 && heap[parent(i)].prioridad < heap[i].prioridad) {
            swap(heap[i], heap[parent(i)]);
            i = parent(i);
        }
    }

    void siftDown(int i) {
        int maxIdx = i;
        int l = left(i);
        int r = right(i);
        int n = heap.size();

        if (l < n && heap[l].prioridad > heap[maxIdx].prioridad) maxIdx = l;
        if (r < n && heap[r].prioridad > heap[maxIdx].prioridad) maxIdx = r;

        if (i != maxIdx) {
            swap(heap[i], heap[maxIdx]);
            siftDown(maxIdx);
        }
    }

public:
    void push(const string& id, int prioridad) {
        heap.push_back(Elemento(id, prioridad));
        siftUp(heap.size() - 1);
    }

    Elemento top() const {
        if (heap.empty()) throw runtime_error("Cola vacia.");
        return heap[0];
    }

    Elemento pop() {
        if (heap.empty()) throw runtime_error("Cola vacia.");
        Elemento topElem = heap[0];
        heap[0] = heap.back();
        heap.pop_back();
        if (!heap.empty()) siftDown(0);
        return topElem;
    }

    bool changePriority(const string& id, int nuevaPrioridad) {
        for (size_t i = 0; i < heap.size(); ++i) {
            if (heap[i].id == id) {
                int prioridadAntigua = heap[i].prioridad;
                heap[i].prioridad = nuevaPrioridad;
                if (nuevaPrioridad > prioridadAntigua) {
                    siftUp(i);
                } else {
                    siftDown(i);
                }
                return true;
            }
        }
        return false; // Elemento no encontrado
    }

    bool empty() const { return heap.empty(); }

    void printState() const {
        cout << "[ ";
        for (size_t i = 0; i < heap.size(); ++i) {
            cout << "(" << heap[i].id << ": " << heap[i].prioridad << ") ";
        }
        cout << "]" << endl;
    }
};

int main() {
    cout << "=== ADMINISTRACION DE COLA DE PRIORIDAD EN DEV-C++ 5.11 ===" << endl;
    ColaPrioridadCustom pq;

    pq.push("Tarea_Backup", 10);
    pq.push("Tarea_Render", 50);
    pq.push("Tarea_Red", 30);
    pq.push("Tarea_Kernel", 90);

    cout << "Estado inicial de la Cola de Prioridad:" << endl;
    pq.printState();

    cout << "\nIncrementando la prioridad de 'Tarea_Render' de 50 a 95 (Change-Key)..." << endl;
    pq.changePriority("Tarea_Render", 95);
    pq.printState();

    cout << "\nProcesando elementos por orden estricto de prioridad:" << endl;
    while (!pq.empty()) {
        Elemento e = pq.pop();
        cout << "Procesando: " << e.id << " (Prioridad: " << e.prioridad << ")" << endl;
    }

    return 0;
}



6. HEAPS BINOMIALES: ESTRUCTURA, ÁRBOLES BINOMIALES Y OPERACIÓN DE UNIÓN
Aunque los montículos binarios son excepcionalmente eficientes para inserciones y extracciones O(log n), presentan una severa limitación algorítmica: la operación de fusión o unión (Union / Merge) de dos heaps binarios de tamaño n requiere concatenar los arreglos y ejecutar `Heapify`, con una complejidad de O(n). Para solventar esta ineficiencia, Jean Vuillemin introdujo en 1978 la estructura de Montículo Binomial (Binomial Heap).
6.1 Árboles Binomiales (Binomial Trees B_k)
Un Montículo Binomial está constituido por un bosque o colección de Árboles Binomiales B_k. Un árbol binomial de orden k se define recursivamente como sigue:
Caso Base (B_0): El árbol binomial B_0 consiste en un único nodo independiente de grado 0.
Caso Inductivo (B_k): Un árbol binomial de orden B_k se construye uniendo dos árboles binomiales idénticos de orden B_{k-1}, enlazando la raíz de uno como el hijo más a la izquierda de la raíz del otro.
Demostración por Inducción del Número de Nodos |B_k| = 2^k:
Caso Base (k=0): |B_0| = 1 = 2⁰ (Cierto).
Hipotésis Inductiva: Asumimos cierto que para k=m, |B_m| = 2^m.
Paso Inductivo (k=m+1): Por definición, B_{m+1} se forma uniendo dos árboles B_m. Por ende, |B_{m+1}| = |B_m| + |B_m| = 2^m + 2^m = 2 · 2^m = 2^(m+1). Q.E.D.
Las propiedades matemáticas formales de un árbol binomial B_k son exactamente las siguientes:
1. Número de Nodos: Posee exactamente 2^k nodos.
2. Altura del Árbol: La altura del árbol es exactamente k.
3. Grado de la Raíz: El grado de la raíz principal es k (posee k subárboles hijos: B_0, B_1, ..., B_{k-1}).
4. Distribución de Nodos por Nivel (Coeficiente Binomial): El número de nodos a una profundidad d (donde 0 ≤ d ≤ k) viene dado exactamente por el coeficiente binomial C(k, d) = k! / (d! (k - d)!). Esta propiedad matemática otorga el nombre a la estructura.

