// CODIFICACIÓN DE HUFFMAN USANDO MIN-HEAP EN C++ (DEV-C++ 5.11)
// Compresión de texto mediante árbol de frecuencias
// ============================================================================
#include <iostream>
#include <vector>
#include <queue>
#include <string>

using namespace std;

struct NodeHuffman {
    char data;
    unsigned freq;
    NodeHuffman *left, *right;

    NodeHuffman(char d, unsigned f) : data(d), freq(f), left(NULL), right(NULL) {}
};

struct CompareHuffman {
    bool operator()(NodeHuffman* l, NodeHuffman* r) {
        return l->freq > r->freq;
    }
};

void printCodes(NodeHuffman* root, string str) {
    if (!root) return;
    if (root->data != '$') {
        cout << "Caracter: '" << root->data << "' -> Codigo Huffman: " << str << "\n";
    }
    printCodes(root->left, str + "0");
    printCodes(root->right, str + "1");
}

void buildHuffmanTree(char data[], int freq[], int size) {
    priority_queue<NodeHuffman*, vector<NodeHuffman*>, CompareHuffman> minHeap;

    for (int i = 0; i < size; ++i) {
        minHeap.push(new NodeHuffman(data[i], freq[i]));
    }

    while (minHeap.size() != 1) {
        NodeHuffman* left = minHeap.top(); minHeap.pop();
        NodeHuffman* right = minHeap.top(); minHeap.pop();

        NodeHuffman* top = new NodeHuffman('$', left->freq + right->freq);
        top->left = left;
        top->right = right;
        minHeap.push(top);
    }

    cout << "\nCodigos de Huffman generados:" << endl;
    printCodes(minHeap.top(), "");
}

int main() {
    cout << "=== ALGORITMO DE COMPRESION HUFFMAN EN DEV-C++ 5.11 ===" << endl;
    char arr[] = { 'a', 'b', 'c', 'd', 'e', 'f' };
    int freq[] = { 5, 9, 12, 13, 16, 45 };
    int size = sizeof(arr) / sizeof(arr[0]);

    buildHuffmanTree(arr, freq, size);

    return 0;
}



