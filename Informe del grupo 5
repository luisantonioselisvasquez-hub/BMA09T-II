// ============================================================================
// FUSIÓN DE K ARREGLOS ORDENADOS (K-WAY MERGE) EN C++ (DEV-C++ 5.11)
// Uso de Min-Heap para combinar K listas ordenadas en tiempo O(N log K)
// ============================================================================
#include <iostream>
#include <vector>
#include <queue>

using namespace std;

struct ElementoK {
    int valor;
    int arrIdx;
    int elemIdx;

    ElementoK(int v, int a, int e) : valor(v), arrIdx(a), elemIdx(e) {}

    bool operator>(const ElementoK& other) const {
        return valor > other.valor;
    }
};

vector<int> mergeKArrays(const vector<vector<int> >& arrays) {
    priority_queue<ElementoK, vector<ElementoK>, greater<ElementoK> > pq;
    vector<int> resultado;

    // Insertar el primer elemento de cada arreglo en la priority_queue
    for (size_t i = 0; i < arrays.size(); ++i) {
        if (!arrays[i].empty()) {
            pq.push(ElementoK(arrays[i][0], i, 0));
        }
    }

    while (!pq.empty()) {
        ElementoK curr = pq.top();
        pq.pop();

        resultado.push_back(curr.valor);

        // Si el arreglo de origen tiene mas elementos, insertar el siguiente
        if (curr.elemIdx + 1 < (int)arrays[curr.arrIdx].size()) {
            pq.push(ElementoK(arrays[curr.arrIdx][curr.elemIdx + 1], curr.arrIdx, curr.elemIdx + 1));
        }
    }

    return resultado;
}

int main() {
    cout << "=== FUSION DE K ARREGLOS ORDENADOS (K-WAY MERGE) EN DEV-C++ 5.11 ===" << endl;

    vector<vector<int> > arrays(3);
    arrays[0].push_back(1); arrays[0].push_back(5); arrays[0].push_back(9);
    arrays[1].push_back(2); arrays[1].push_back(6); arrays[1].push_back(8);
    arrays[2].push_back(3); arrays[2].push_back(7); arrays[2].push_back(10);

    vector<int> res = mergeKArrays(arrays);

    cout << "Resultado de fusionar K arreglos ordenados: [ ";
    for (size_t i = 0; i < res.size(); ++i) cout << res[i] << " ";
    cout << "]" << endl;

    return 0;
}



