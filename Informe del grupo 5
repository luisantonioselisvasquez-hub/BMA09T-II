// ============================================================================
// ALGORITMO DE DIJKSTRA USANDO COLA DE PRIORIDAD C++ (DEV-C++ 5.11)
// Calculo del camino mas corto desde un nodo origen a todos los vertices
// ============================================================================
#include <iostream>
#include <vector>
#include <queue>
#include <utility>
#include <climits>

using namespace std;

typedef pair<int, int> iPair; // (distancia, nodo)

void dijkstra(int src, const vector<vector<iPair> >& adj, int V) {
    priority_queue<iPair, vector<iPair>, greater<iPair> > pq;
    vector<int> dist(V, INT_MAX);

    pq.push(make_pair(0, src));
    dist[src] = 0;

    while (!pq.empty()) {
        int u = pq.top().second;
        int d = pq.top().first;
        pq.pop();

        if (d > dist[u]) continue;

        for (size_t i = 0; i < adj[u].size(); ++i) {
            int v = adj[u][i].first;
            int weight = adj[u][i].second;

            if (dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
                pq.push(make_pair(dist[v], v));
            }
        }
    }

    cout << "Distancias minimas desde el nodo origen (" << src << "):" << endl;
    for (int i = 0; i < V; ++i) {
        cout << "Nodo " << i << " : " << (dist[i] == INT_MAX ? -1 : dist[i]) << endl;
    }
}

int main() {
    cout << "=== ALGORITMO DE DIJKSTRA EN DEV-C++ 5.11 ===" << endl;
    int V = 5;
    vector<vector<iPair> > adj(V);

    // Grafo dirigido ponderado (u, v, peso)
    adj[0].push_back(make_pair(1, 9));
    adj[0].push_back(make_pair(2, 6));
    adj[0].push_back(make_pair(3, 5));
    adj[0].push_back(make_pair(4, 3));
    adj[2].push_back(make_pair(1, 2));
    adj[2].push_back(make_pair(3, 4));
    adj[4].push_back(make_pair(3, 1));

    dijkstra(0, adj, V);

    return 0;
}



