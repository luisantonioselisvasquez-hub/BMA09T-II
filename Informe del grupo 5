// ============================================================================
// IMPLEMENTACIÓN COMPLETA DE MONTÍCULO BINOMIAL EN C++ (DEV-C++ 5.11)
// Incluye operaciones de Unión (Merge), Inserción y Extracción del Mínimo
// ============================================================================
#include <iostream>
#include <climits>
#include <algorithm>

using namespace std;

struct NodeBinomial {
    int key;
    int degree;
    NodeBinomial* parent;
    NodeBinomial* child;
    NodeBinomial* sibling;

    NodeBinomial(int val) : key(val), degree(0), parent(NULL), child(NULL), sibling(NULL) {}
};

class BinomialHeap {
private:
    NodeBinomial* head;

    // Enlazar dos árboles binomiales del mismo grado B_k para formar B_{k+1}
    void linkTrees(NodeBinomial* minChild, NodeBinomial* maxParent) {
        minChild->parent = maxParent;
        minChild->sibling = maxParent->child;
        maxParent->child = minChild;
        maxParent->degree++;
    }

    // Fusionar las listas de raíces de dos heaps ordenadas por grado creciente
    NodeBinomial* mergeRoots(NodeBinomial* h1, NodeBinomial* h2) {
        if (h1 == NULL) return h2;
        if (h2 == NULL) return h1;

        NodeBinomial* headRes = NULL;
        NodeBinomial** tailRes = &headRes;

        while (h1 != NULL && h2 != NULL) {
            if (h1->degree <= h2->degree) {
                *tailRes = h1;
                h1 = h1->sibling;
            } else {
                *tailRes = h2;
                h2 = h2->sibling;
            }
            tailRes = &((*tailRes)->sibling);
        }
        if (h1 != NULL) *tailRes = h1;
        else *tailRes = h2;

        return headRes;
    }

public:
    BinomialHeap() : head(NULL) {}

    // Operación Principal: Unión de dos Heaps Binomiales en O(log N)
    void unionHeap(BinomialHeap& other) {
        NodeBinomial* newHead = mergeRoots(this->head, other.head);
        this->head = NULL;
        other.head = NULL;

        if (newHead == NULL) return;

        NodeBinomial* prev = NULL;
        NodeBinomial* curr = newHead;
        NodeBinomial* next = curr->sibling;

        while (next != NULL) {
            if ((curr->degree != next->degree) ||
                (next->sibling != NULL && next->sibling->degree == curr->degree)) {
                prev = curr;
                curr = next;
            } else {
                if (curr->key <= next->key) {
                    curr->sibling = next->sibling;
                    linkTrees(next, curr);
                } else {
                    if (prev == NULL) newHead = next;
                    else prev->sibling = next;
                    linkTrees(curr, next);
                    curr = next;
                }
            }
            next = curr->sibling;
        }
        this->head = newHead;
    }

    void insert(int key) {
        BinomialHeap tempHeap;
        tempHeap.head = new NodeBinomial(key);
        unionHeap(tempHeap);
    }

    int getMin() const {
        if (head == NULL) throw runtime_error("Heap binomial vacio.");
        int minVal = INT_MAX;
        NodeBinomial* curr = head;
        while (curr != NULL) {
            if (curr->key < minVal) minVal = curr->key;
            curr = curr->sibling;
        }
        return minVal;
    }

    int extractMin() {
        if (head == NULL) throw runtime_error("Heap binomial vacio.");

        NodeBinomial* minNode = head;
        NodeBinomial* minPrev = NULL;
        NodeBinomial* curr = head;
        NodeBinomial* prev = NULL;
        int minKey = head->key;

        while (curr != NULL) {
            if (curr->key < minKey) {
                minKey = curr->key;
                minNode = curr;
                minPrev = prev;
            }
            prev = curr;
            curr = curr->sibling;
        }

        if (minPrev == NULL) head = head->sibling;
        else minPrev->sibling = minNode->sibling;

        // Invertir la lista de hijos del nodo mínimo extraído
        NodeBinomial* childList = NULL;
        NodeBinomial* childCurr = minNode->child;
        while (childCurr != NULL) {
            NodeBinomial* nextChild = childCurr->sibling;
            childCurr->sibling = childList;
            childCurr->parent = NULL;
            childList = childCurr;
            childCurr = nextChild;
        }

        BinomialHeap tempHeap;
        tempHeap.head = childList;
        unionHeap(tempHeap);

        delete minNode;
        return minKey;
    }

    bool empty() const { return head == NULL; }
};

int main() {
    cout << "=== DEMOSTRACION DE MONTICULO BINOMIAL EN DEV-C++ 5.11 ===" << endl;
    BinomialHeap h1, h2;

    cout << "Insertando elementos en Heap H1: {12, 7, 25, 15, 28}" << endl;
    h1.insert(12); h1.insert(7); h1.insert(25); h1.insert(15); h1.insert(28);

    cout << "Insertando elementos en Heap H2: {45, 3, 18, 30}" << endl;
    h2.insert(45); h2.insert(3); h2.insert(18); h2.insert(30);

    cout << "\nMinimo de H1: " << h1.getMin() << endl;
    cout << "Minimo de H2: " << h2.getMin() << endl;

    cout << "\nUniendo (Union/Merge) H2 en H1 en O(log N)..." << endl;
    h1.unionHeap(h2);

    cout << "Nuevo Minimo del Heap Unificado: " << h1.getMin() << endl;

    cout << "\nExtrayendo todos los elementos en orden ascendente:" << endl;
    while (!h1.empty()) {
        cout << h1.extractMin() << " ";
    }
    cout << endl;

    return 0;
}



