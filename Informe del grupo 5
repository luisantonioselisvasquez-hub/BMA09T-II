// ============================================================================
// IMPLEMENTACIÓN COMPLETA DE MAX-HEAP Y MIN-HEAP EN C++ (DEV-C++ 5.11)
// Compilable directamente en Dev-C++ 5.11 con compilador GCC 4.9.2 / C++11
// ============================================================================
#include <iostream>
#include <vector>
#include <stdexcept>
#include <algorithm>

using namespace std;

// Clase Templatizada para Max-Heap Binario
template <typename T>
class MaxHeap {
private:
    vector<T> heap;

    int parent(int i) const { return (i - 1) / 2; }
    int left(int i) const { return 2 * i + 1; }
    int right(int i) const { return 2 * i + 2; }

    void siftUp(int i) {
        while (i > 0 && heap[parent(i)] < heap[i]) {
            swap(heap[i], heap[parent(i)]);
            i = parent(i);
        }
    }

    void siftDown(int i) {
        int maxIndex = i;
        int l = left(i);
        int r = right(i);
        int size = heap.size();

        if (l < size && heap[l] > heap[maxIndex]) {
            maxIndex = l;
        }
        if (r < size && heap[r] > heap[maxIndex]) {
            maxIndex = r;
        }
        if (i != maxIndex) {
            swap(heap[i], heap[maxIndex]);
            siftDown(maxIndex);
        }
    }

public:
    MaxHeap() {}

    bool empty() const {
        return heap.empty();
    }

    int size() const {
        return heap.size();
    }

    void insert(const T& key) {
        heap.push_back(key);
        siftUp(heap.size() - 1);
    }

    T getMax() const {
        if (heap.empty()) {
            throw runtime_error("Error: El Heap está vacío.");
        }
        return heap[0];
    }

    T extractMax() {
        if (heap.empty()) {
            throw runtime_error("Error: El Heap está vacío.");
        }
        T maxItem = heap[0];
        heap[0] = heap.back();
        heap.pop_back();
        if (!heap.empty()) {
            siftDown(0);
        }
        return maxItem;
    }

    void printHeap() const {
        cout << "[ ";
        for (size_t i = 0; i < heap.size(); ++i) {
            cout << heap[i] << " ";
        }
        cout << "]" << endl;
    }
};

int main() {
    cout << "=== DEMOSTRACION DE MAX-HEAP EN DEV-C++ 5.11 ===" << endl;
    MaxHeap<int> mh;

    int datos[] = {40, 20, 10, 80, 50, 90, 30, 15, 70, 60};
    int n = sizeof(datos) / sizeof(datos[0]);

    cout << "Insertando elementos secuencialmente..." << endl;
    for (int i = 0; i < n; ++i) {
        mh.insert(datos[i]);
        cout << "Insertado: " << datos[i] << " -> Heap actual: ";
        mh.printHeap();
    }

    cout << "\nEl elemento maximo en la raiz es: " << mh.getMax() << endl;

    cout << "\nExtrayendo elementos en orden descendente (Heapsort implícito):" << endl;
    while (!mh.empty()) {
        cout << "Extraido Maximo: " << mh.extractMax() << " -> Estado del Heap: ";
        mh.printHeap();
    }

    return 0;
}



4. CONSTRUCCIÓN DE HEAPS Y EL ALGORITMO HEAPIFY DE FLOYD
Dada una colección no ordenada de n elementos almacenados en un arreglo, existen dos enfoques algorítmicos para transformarla en un heap válido:
Enfoque 1 (Inserciones Sucesivas): Comenzar con un heap vacío e insertar los n elementos uno por uno mediante Sift-Up. Cada inserción k toma tiempo O(log k). La complejidad total es ∑ (k=1 a n) log k = log(n!) = O(n log n).
Enfoque 2 (Algoritmo Heapify de Floyd): Construir el heap 'Bottom-Up' (desde las hojas hacia la raíz) utilizando reajustes Sift-Down. Este algoritmo logra construir un heap completo en tiempo estrictamente Lineal O(n).
4.1 Demostración Matemática de la Cota Lineal O(n) de Heapify
El algoritmo Heapify de Robert W. Floyd opera iterando desde el último nodo interno (el padre del último elemento, i = ⌊n/2⌋ - 1) hacia atrás hasta la raíz i = 0, invocando Sift-Down en cada posición. Los nodos hoja (que constituyen la mitad de los nodos del árbol, desde ⌊n/2⌋ hasta n-1) satisfacen trivialmente la propiedad de heap y no requieren ningún procesamiento.
Para calcular el trabajo total realizado por Heapify, consideramos la altura del árbol h = ⌊log₂ n⌋. Un árbol binario completo de altura h posee a lo sumo ⌈n / 2^(k+1)⌉ nodos a una altura k (donde k=0 corresponde a las hojas y k=h corresponde a la raíz). El costo máximo de aplicar Sift-Down a un nodo situado a altura k es proporcional a k. Por consiguiente, el número total de operaciones de intercambio T(n) está acotado por la suma:
$$ T(n) = \sum_{k=0}^{\lfloor \log_2 n \rfloor} \left\lceil \frac{n}{2^{k+1}} \right\rceil \cdot O(k) \le \frac{n}{2} \sum_{k=0}^{\infty} \frac{k}{2^k} $$
Para evaluar la serie infinita ∑ (k=0 a ∞) k / 2^k, utilizamos la serie geométrica estándar:
$$ \sum_{k=0}^{\infty} x^k = \frac{1}{1 - x} \quad \text{para } |x| < 1 $$
Derivando ambos lados con respecto a x:
$$ \sum_{k=0}^{\infty} k x^{k-1} = \frac{d}{dx} \left( \frac{1}{1 - x} \right) = \frac{1}{(1 - x)^2} $$
Multiplicando toda la ecuación por x:
$$ \sum_{k=0}^{\infty} k x^k = \frac{x}{(1 - x)^2} $$
Sustituyendo x = 1/2 en la fórmula resultante:
$$ \sum_{k=0}^{\infty} \frac{k}{2^k} = \frac{1/2}{(1 - 1/2)^2} = \frac{1/2}{1/4} = 2 $$
Sustituyendo este resultado de la serie en la ecuación del trabajo total T(n):
$$ T(n) \le \frac{n}{2} \cdot 2 = n \implies T(n) = O(n) $$
Queda demostrado matemáticamente que el algoritmo de construcción Bottom-Up de Floyd reorganiza un arreglo arbitrario en un heap válido ejecutando a lo sumo 2n comparaciones, demostrando una complejidad lineal O(n), significativamente superior al enfoque ingenuo de O(n log n).

