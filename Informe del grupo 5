// ============================================================================
// CONSTRUCCIÓN DE HEAP EN TIEMPO LINEAL O(N) (ALGORITMO HEAPIFY DE FLOYD)
// Código optimizado para Dev-C++ 5.11 / GCC 4.9.2
// ============================================================================
#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// Función auxiliar Sift-Down para reajustar subárbol con raíz en i
void minHeapify(vector<int>& arr, int n, int i) {
    int smallest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] < arr[smallest]) {
        smallest = left;
    }
    if (right < n && arr[right] < arr[smallest]) {
        smallest = right;
    }
    if (smallest != i) {
        swap(arr[i], arr[smallest]);
        minHeapify(arr, n, smallest);
    }
}

// Algoritmo de Floyd para construir un Min-Heap en O(N)
void buildMinHeap(vector<int>& arr) {
    int n = arr.size();
    // Iniciar desde el último nodo padre no-hoja: (n/2) - 1
    for (int i = (n / 2) - 1; i >= 0; --i) {
        minHeapify(arr, n, i);
    }
}

int main() {
    cout << "=== CONSTRUCCION LINEAL DE HEAP O(N) EN DEV-C++ 5.11 ===" << endl;
    int datos[] = {95, 30, 80, 10, 50, 70, 20, 60, 40, 15, 85, 25};
    int n = sizeof(datos) / sizeof(datos[0]);
    vector<int> arr(datos, datos + n);

    cout << "Arreglo desordenado original: [ ";
    for (int i = 0; i < n; ++i) cout << arr[i] << " ";
    cout << "]" << endl;

    buildMinHeap(arr);

    cout << "\nArreglo reorganizado como Min-Heap O(N): [ ";
    for (int i = 0; i < n; ++i) cout << arr[i] << " ";
    cout << "]" << endl;

    return 0;
}



5. COLAS DE PRIORIDAD: DEFINICIÓN Y ADMINISTRACIÓN DE ELEMENTOS CON PRIORIDAD
Una Cola de Prioridad (Priority Queue) es un Tipo de Dato Abstracto (ADT) que extiende el concepto tradicional de cola First-In, First-Out (FIFO). En una cola de prioridad, cada elemento almacenado posee una clave de prioridad asociada. La regla de atención establece que el elemento devuelto o removido en cualquier momento es de forma incondicional aquel que posee la mayor (o menor) prioridad, independientemente de su orden cronológico de llegada a la estructura.
El ADT Cola de Prioridad define las siguientes operaciones fundamentales de administración:
Insert / Push (e, p): Inserta un elemento 'e' con prioridad 'p' en la estructura. Complejidad esperada: O(log n).
Find-Max / Top / Peek (): Retorna el elemento con mayor prioridad sin modificar la estructura. Complejidad esperada: O(1).
Extract-Max / Pop (): Elimina y retorna el elemento con mayor prioridad de la estructura. Complejidad esperada: O(log n).
Change-Key / Update-Key (e, nueva_p): Modifica la prioridad del elemento 'e' al nuevo valor 'nueva_p' y reorganiza la estructura. Complejidad esperada: O(log n).
