// ============================================================================
// ALGORITMO DE ORDENAMIENTO HEAPSORT IN-PLACE EN C++ (DEV-C++ 5.11)
// Complejidad O(N log N) garantizada en el peor caso sin memoria adicional
// ============================================================================
#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void heapify(vector<int>& arr, int n, int i) {
    int largest = i;
    int l = 2 * i + 1;
    int r = 2 * i + 2;

    if (l < n && arr[l] > arr[largest]) largest = l;
    if (r < n && arr[r] > arr[largest]) largest = r;

    if (largest != i) {
        swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}

void heapSort(vector<int>& arr) {
    int n = arr.size();

    // 1. Construir Max-Heap en O(N)
    for (int i = n / 2 - 1; i >= 0; --i) {
        heapify(arr, n, i);
    }

    // 2. Extraer elementos uno por uno e intercambiar con el final
    for (int i = n - 1; i > 0; --i) {
        swap(arr[0], arr[i]);
        heapify(arr, i, 0);
    }
}

int main() {
    cout << "=== ALGORITMO HEAPSORT EN DEV-C++ 5.11 ===" << endl;
    int datos[] = {12, 11, 13, 5, 6, 7, 1, 9, 3, 2, 8, 4};
    int n = sizeof(datos) / sizeof(datos[0]);
    vector<int> arr(datos, datos + n);

    cout << "Arreglo original: [ ";
    for (int i = 0; i < n; ++i) cout << arr[i] << " ";
    cout << "]" << endl;

    heapSort(arr);

    cout << "Arreglo ordenado con Heapsort: [ ";
    for (int i = 0; i < n; ++i) cout << arr[i] << " ";
    cout << "]" << endl;

    return 0;
}



